# Environment Configuration Template
# Copy this to .env and fill in your actual values

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=bakery_db

# Application Settings
APP_NAME=Sweet Bliss Bakery
APP_EMAIL=hello@sweetbliss.com
APP_PHONE=(555) 123-4567
APP_ADDRESS=123 Bakery Lane
APP_CITY=Food City
APP_STATE=FC
APP_ZIP=12345

# Business Hours
OPEN_MONDAY=07:00
CLOSE_MONDAY=19:00
OPEN_SATURDAY=08:00
CLOSE_SATURDAY=18:00
OPEN_SUNDAY=09:00
CLOSE_SUNDAY=17:00

# Payment Settings
PAYMENT_GATEWAY=stripe
TAX_RATE=0.10
SHIPPING_COST=0.00

# Email Settings
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@sweetbliss.com

# Debug Mode (true for development, false for production)
DEBUG=true

# Security
SESSION_TIMEOUT=1800
SITE_URL=http://localhost/bakery
